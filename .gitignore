# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.local
# tsc -b incremental artifact — machine-generated, embeds absolute local paths
*.tsbuildinfo

# --- Env / secrets ---
.env
*.env
# .env.local / .env.production / … (suffix variants aren't caught by *.env).
# NB: gitignore has no inline comments — a trailing "# …" becomes part of the pattern.
.env.*
!.env.example

# --- Personal data — NEVER commit (lives only on your machine) ---
# Your tracked jobs/applications. Demo seeds are shipped as *.example.csv and
# copied to the live files on first run (api/app/config.py::ensure_dirs).
# **-form so NESTED artifacts (data/backups/index.sqlite, data/exports/jobs.csv)
# are ignored too — the hook regex blocks them at any depth, and .gitignore must
# match its reach (pinned by the parity tests).
data/**/*.csv
!data/*.example.csv
data/**/*.tmp
data/**/*.bak
data/patterns.json
# Everything under data/jobs/ is derived from your postings/CV — snapshots (.md), evaluations
# (.json), tailored CVs (.cv.tex / .cv.pdf), cover letters (.cover_letter.md). Block the whole
# dir (keep only the .gitkeep placeholder) so no artifact type can slip through.
data/jobs/*
!data/jobs/.gitkeep
# The derived index (and any other db artifact) over your real corpus — match the
# hook's extension list (sqlite|sqlite3|db) and its any-depth reach, not one filename.
data/**/*.sqlite
data/**/*.sqlite3
data/**/*.db
# Your own cover-letter style samples (read as references; curated samples that
# ship with the repo live in api/app/cover_letters/ instead). Documented in
# docs/FILESYSTEM.md (the folder is protected, so no README ships inside it).
data/cover_letter_samples/
config/profile.yml
config/profile.yaml
config/memory.yml
config/memory.yaml
config/portals.yml
config/portals.yaml
# Your personal company registry (aliases for acquisitions/rebrands you track)
config/companies.yml
config/companies.yaml
config/cv_source.md
config/job_source.md
# Your personal-term denylist (name/phone/handles) read by the PII guards — the
# file itself is concentrated PII. Seed it from config/pii_terms.example.txt.
config/pii_terms.txt

# Your résumé, cover letters, and any application materials
resume/*
!resume/README.md
applications/*
!applications/README.md
!applications/.gitkeep

# --- Logs / runtime status ---
logs/
*.log
# The runtime status page (agent-written, carries real activity incl. chat
# excerpts). Lives at logs/STATUS.md now; the root path is the legacy location.
/STATUS.md

# Runtime artifacts written when tests mount ./api as /app (ROOT becomes ./api):
# the live data/logs/applications/status, NOT source. The real ones live at repo root.
api/STATUS.md
api/data/
api/logs/
api/applications/
# Mountpoints for ./config and ./resume that a test-mount can materialize REAL
# profile/CV files into — hook-blocked (api/ prefix in PII_PATH_RE), so .gitignore
# must match (pinned by the parity tests).
api/config/
api/resume/
# Empty mountpoints Docker creates in ./api when the docs are bind-mounted into /app
# during a `docker compose run` test (the real docs live at repo root).
api/README.md
api/AGENTS.md
api/docs/

# --- OS ---
.DS_Store
Thumbs.db

# Reference repos studied for ideas — not ours to commit.
externals/

# Generated demo/test datasets (PEREGRINE_DATASET=<persona>); seeded from code.
.demo/
