# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.local

# --- Env / secrets ---
.env
*.env
!.env.example

# --- Personal data — NEVER commit (lives only on your machine) ---
# Your tracked jobs/applications. Demo seeds are shipped as *.example.csv and
# copied to the live files on first run (api/app/config.py::ensure_dirs).
data/*.csv
!data/*.example.csv
data/*.tmp
data/*.bak
data/jobs/*.md
data/jobs/*.json
!data/jobs/.gitkeep
data/index.sqlite
config/profile.yml
config/memory.yml
config/portals.yml

# Your résumé, cover letters, and any application materials
resume/*
!resume/README.md
applications/*
!applications/README.md
!applications/.gitkeep

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
Thumbs.db

# Reference repos studied for ideas — not ours to commit.
externals/

# Generated demo/test datasets (PEREGRINE_DATASET=<persona>); seeded from code.
.demo/
