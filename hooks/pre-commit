#!/usr/bin/env bash
# Fast local checks before a commit is created:
#   1. py_compile staged Python (catch syntax breaks)
#   2. crawl-policy guard: outbound HTTP must go through crawl_policy.safe_get
#   3. personal-data / PII guard: never commit your real CV, profile, jobs, or contacts
#   4. personal-term denylist: your name/phone/handles from config/pii_terms.txt
# Enabled via core.hooksPath=hooks — run scripts/install-hooks.sh once per clone
# (start.sh also self-heals this). Bypass in a pinch with: git commit --no-verify
set -euo pipefail

# Shared PII patterns/filters — single source of truth with commit-msg + CI backstop.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/pii-lib.sh"

# ACMR (not ACM): include Renames, so a personal file staged via `git mv x config/profile.yml`
# (status R) can't slip past the guard. --name-only lists the rename DESTINATION (the new path).
# quotepath=off: git's default C-quotes non-ASCII paths ("resume/\350\213\217…") — the quoted
# form starts with a literal `"` so the ^-anchored path regex would NEVER match (fail-open for
# e.g. a CV named in Chinese). Off = raw UTF-8 bytes, which the regex handles.
staged="$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0
fail=0

# 1) Python syntax ---------------------------------------------------------
py_files="$(printf '%s\n' "$staged" | grep -E '\.py$' || true)"
if [ -n "$py_files" ] && ! python3 -m py_compile $py_files 2>/tmp/peregrine-pyc.err; then
  echo "✗ pre-commit: Python syntax error:" >&2
  cat /tmp/peregrine-pyc.err >&2
  fail=1
fi

# 2) Crawl-policy guard ----------------------------------------------------
# Every outbound *job-board* fetch must route through crawl_policy.safe_get (the
# good-bot rule). No raw HTTP clients or browser-UA spoofing elsewhere under api/.
# Exempt: crawl_policy.py itself, and llm.py (LLM-provider API calls, not crawling).
guard_files="$(printf '%s\n' "$staged" | grep -E '^api/.*\.py$' \
  | grep -vE 'api/app/agent/(crawl_policy|llm)\.py' || true)"
if [ -n "$guard_files" ]; then
  hits="$(grep -nE 'httpx\.(get|post|put|request|stream|Client)|requests\.(get|post)|urllib\.request|Mozilla/' $guard_files || true)"
  if [ -n "$hits" ]; then
    echo "✗ pre-commit: raw HTTP / browser-UA outside crawl_policy.py" >&2
    echo "  route outbound fetches through crawl_policy.safe_get():" >&2
    printf '  %s\n' "$hits" >&2
    fail=1
  fi
fi

# 3) Personal-data / PII guard --------------------------------------------
# Your real CV, profile, tracked jobs, applications, and contacts live ONLY on your
# machine — they're gitignored. This is the hard backstop in case one is force-added
# (`git add -f`) or .gitignore is edited. Demo seeds ship as *.example.csv / are
# generated from code (PEREGRINE_DATASET), so they never match here. The patterns
# live in hooks/pii-lib.sh; .gitignore parity is pinned by api/tests/test_pii_hook.py.
pii_paths="$(printf '%s\n' "$staged" | pii_offending_paths)"
if [ -n "$pii_paths" ]; then
  echo "✗ pre-commit: refusing to commit personal-data files (these stay on your machine):" >&2
  printf '  %s\n' "$pii_paths" >&2
  fail=1
fi

# Content scan: a real-looking email in a STAGED ADDED line (test fixtures + demo seeds
# use @example.com; commit-authoring noreply@ lives in the message, not a file). Catches
# PII pasted into a source/test/fixture file. Safe domains are allow-listed.
# --no-ext-diff: `git diff` is porcelain and honors GIT_EXTERNAL_DIFF / diff.external
# (difftastic/delta setups) — driver output has no ^+ lines, which would silently
# blank BOTH the email scan and the denylist scan below (fail-open, no signal).
added_lines="$(git -c core.quotepath=off diff --cached -U0 --no-ext-diff --diff-filter=ACMR \
  | grep -E '^\+' | grep -vE '^[+]{3} ([ab]/|/dev/null)' || true)"
mail_hits="$(printf '%s\n' "$added_lines" | pii_offending_emails)"
if [ -n "$mail_hits" ]; then
  echo "✗ pre-commit: a real-looking email address in a staged change (PII?):" >&2
  printf '    %s\n' "$mail_hits" >&2
  echo "  if it's a placeholder, use an @example.com address; if intended, bypass with --no-verify." >&2
  fail=1
fi

# 4) Personal-term denylist ------------------------------------------------
# Generic patterns can't know YOUR name or phone number. config/pii_terms.txt
# (gitignored — it IS concentrated PII; seed from config/pii_terms.example.txt) lists
# your real strings, and any staged added line OR staged filename containing one is
# refused. Skipped silently when the file doesn't exist.
term_hits="$(printf '%s\n' "$staged" "$added_lines" | pii_offending_terms)"
if [ -n "$term_hits" ]; then
  echo "✗ pre-commit: a personal term from config/pii_terms.txt appears in the staged change:" >&2
  printf '    %s\n' "$term_hits" >&2
  echo "  scrub it (use a placeholder), or bypass once with --no-verify if it's a false positive." >&2
  fail=1
fi

[ "$fail" -eq 0 ] || { echo "  (fix the above, or bypass once with: git commit --no-verify)" >&2; exit 1; }
