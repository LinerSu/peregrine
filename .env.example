# ---------------------------------------------------------------------------
# Peregrine — environment configuration
# Copy to `.env` and fill in. `docker compose up` reads this file.
# ---------------------------------------------------------------------------

# LLM provider: one of "anthropic" | "openai" | "ollama" | "mock"
# "mock" needs no key and returns canned responses so the app boots for demos.
LLM_PROVIDER=mock

# Model name for the chosen provider (ignored by "mock").
#   anthropic -> e.g. claude-sonnet-4-5
#   openai    -> e.g. gpt-4o-mini
#   ollama    -> e.g. llama3.1
LLM_MODEL=claude-sonnet-4-6

# API keys (only the one matching LLM_PROVIDER is required).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama base URL (only for LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# Backend
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Demo / test datasets. Leave EMPTY for normal use (your real, gitignored data).
# Set to a persona to run the app against an isolated, seeded demo dataset — handy
# for trying the app on a fresh clone, testing a new feature, screenshots, or CI.
# The APP then reads/writes only that dataset; your real data/ and config/ are left
# alone. They do stay on disk at their normal paths, so a local CLI (Internal mode) or
# any script reading the repo directly still sees them — see docs/manual/datasets.md.
# Switch back by clearing this.
#   one of: ai-engineer | ux-designer | chem-phd | bio-scientist | law-student
# (with the default Docker stack the dataset lives inside the API container;
#  reset a persona with: docker compose up -d --force-recreate api)
PEREGRINE_DATASET=

# Where the frontend reaches the API (build-time, web container).
# Leave EMPTY to use the built-in nginx proxy (recommended). Set to a full URL
# (e.g. http://localhost:8000) only if you run the API separately.
VITE_API_BASE=

# The assistant panel has two modes (toggle in the web UI):
#   External -> the API-backed chat above (LLM_PROVIDER + key, metered).
#   Internal -> a LOCAL terminal running your coding CLI on your own subscription
#               (no API key, no per-token cost).
# To use Internal mode, install ttyd and run `./scripts/terminal.sh` on the host
# (it binds to 127.0.0.1 — local-only; never expose it). Leave this EMPTY unless
# you change the terminal port; default is http://localhost:7681 (build-time).
VITE_TERMINAL_URL=

# Which CLI Internal mode serves, and on which port. These are read by
# scripts/terminal.sh and scripts/install-terminal-service.sh — NOT by docker
# compose — so export them in your shell, or pass them inline:
#
#   PEREGRINE_TERMINAL_CMD=codex ./scripts/terminal.sh
#
# Default is `claude` (Claude Code). `codex` (OpenAI Codex CLI) launches fine and
# every deterministic route works from either, but the guided prompts Internal
# mode hands you ("evaluate fit for 2026-001") rely on a skill file that currently
# only Claude Code auto-loads — see docs/manual/modes.md before switching.
# A multi-word value is split on spaces, so `claude --resume` works.
#PEREGRINE_TERMINAL_CMD=claude
#PEREGRINE_TERMINAL_PORT=7681

# Container identity (docker-compose.yml `user:`): the api container runs as this
# uid/gid so files it writes into the bind mounts (data/, logs/, .demo/) land on
# the host owned by YOU, not root. `./start.sh` exports your real ids automatically;
# set these only if you run `docker compose up` directly and your uid isn't 1000.
#PEREGRINE_UID=1000
#PEREGRINE_GID=1000
