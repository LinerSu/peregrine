# ---------------------------------------------------------------------------
# Peregrine — environment configuration
# Copy to `.env` and fill in. `docker compose up` reads this file.
# ---------------------------------------------------------------------------

# LLM provider: one of "anthropic" | "openai" | "ollama" | "mock"
# "mock" needs no key and returns canned responses so the app boots for demos.
LLM_PROVIDER=mock

# Model name for the chosen provider (ignored by "mock").
#   anthropic -> e.g. claude-sonnet-4-5
#   openai    -> e.g. gpt-4o-mini
#   ollama    -> e.g. llama3.1
LLM_MODEL=claude-sonnet-4-6

# API keys (only the one matching LLM_PROVIDER is required).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama base URL (only for LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# Backend
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Demo / test datasets. Leave EMPTY for normal use (your real, gitignored data).
# Set to a persona to run the app against an isolated, seeded demo dataset — handy
# for trying the app on a fresh clone, testing a new feature, screenshots, or CI.
# Your real data/ and config/ are left untouched; switch back by clearing this.
#   one of: ai-engineer | ux-designer | chem-phd | bio-scientist | law-student
# (reset a persona by deleting its api/.demo/<persona>/ directory, then restart)
PEREGRINE_DATASET=

# Where the frontend reaches the API (build-time, web container).
# Leave EMPTY to use the built-in nginx proxy (recommended). Set to a full URL
# (e.g. http://localhost:8000) only if you run the API separately.
VITE_API_BASE=

# The assistant panel has two modes (toggle in the web UI):
#   External         -> the API-backed chat above (LLM_PROVIDER + key, metered).
#   Internal (Claude) -> a LOCAL terminal running `claude` on your own Anthropic
#                        subscription (no API key, no per-token cost).
# To use Internal mode, install ttyd and run `./scripts/terminal.sh` on the host
# (it binds to 127.0.0.1 — local-only; never expose it). Leave this EMPTY unless
# you change the terminal port; default is http://localhost:7681 (build-time).
VITE_TERMINAL_URL=
